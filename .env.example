# Copy to .env and change every value. .env is git-ignored; never commit it.
#   cp .env.example .env

# Postgres superuser (only used by the container and the init script).
POSTGRES_PASSWORD=change-me

# One database role per service (created by deploy/postgres/init on first start).
AUTH_DB_PASSWORD=change-me-auth
CATALOG_DB_PASSWORD=change-me-catalog
ORDER_DB_PASSWORD=change-me-order
PAYMENT_DB_PASSWORD=change-me-payment
